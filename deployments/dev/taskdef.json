{
  "family": "secure-cicd-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::182399707265:role/secure-cicd-task-execution",
  "taskRoleArn": "arn:aws:iam::182399707265:role/secure-cicd-task",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "app",
      "image": "182399707265.dkr.ecr.eu-west-1.amazonaws.com/secure-cicd-app:4-c704cec@sha256:d04bb009993d2af46c2ed107dd59275c719cf4b63d3e71f744cc901552f892b3",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "readonlyRootFilesystem": true,
      "user": "10001",
      "linuxParameters": {
        "initProcessEnabled": true,
        "capabilities": {
          "drop": [
            "ALL"
          ]
        }
      },
      "environment": [
        {
          "name": "APP_VERSION",
          "value": "4-c704cec"
        },
        {
          "name": "PORT",
          "value": "8080"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request;urllib.request.urlopen('http://127.0.0.1:8080/health',timeout=2)\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/secure-cicd-app",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "app"
        }
      },
      "mountPoints": [
        {
          "sourceVolume": "tmp",
          "containerPath": "/tmp",
          "readOnly": false
        }
      ],
      "stopTimeout": 30
    }
  ],
  "volumes": [
    {
      "name": "tmp"
    }
  ],
  "tags": [
    {
      "key": "app",
      "value": "secure-cicd-app"
    },
    {
      "key": "build",
      "value": "4-c704cec"
    },
    {
      "key": "managed-by",
      "value": "jenkins"
    }
  ]
}
