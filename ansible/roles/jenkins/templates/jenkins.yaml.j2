# Managed by Ansible (roles/jenkins/templates/jenkins.yaml.j2). Change it there, not in the UI.
jenkins:
  systemMessage: "Mod9 secure CI/CD - configured by Ansible (Configuration as Code)"
  numExecutors: 2
  securityRealm:
    local:
      allowsSignup: false
      users:
        - id: "admin"
          password: "${JENKINS_ADMIN_PASSWORD}"
  authorizationStrategy:
    loggedInUsersCanDoAnything:
      allowAnonymousRead: false

unclassified:
  location:
    url: "http://{{ jenkins_public_host }}:8080/"
  globalLibraries:
    libraries:
      - name: "secure-pipeline-lib"
        defaultVersion: "main"
        implicit: false
        allowVersionOverride: true
        retriever:
          modernSCM:
            libraryPath: "jenkins-shared-library"
            scm:
              git:
                id: "secure-pipeline-lib"
                remote: "https://github.com/{{ github_owner }}/{{ github_repo }}.git"
                credentialsId: "github-gitops-token"
                traits:
                  - "gitBranchDiscovery"

credentials:
  system:
    domainCredentials:
      - credentials:
          - string:
              scope: GLOBAL
              id: "aws-account-id"
              secret: "${AWS_ACCOUNT_ID}"
              description: "AWS account id (used to build the ECR registry and role ARNs)"
          - string:
              scope: GLOBAL
              id: "sonar-token"
              secret: "${SONAR_TOKEN}"
              description: "SonarQube analysis token (rotated by Ansible)"
          - string:
              scope: GLOBAL
              id: "nvd-api-key"
              secret: "${NVD_API_KEY}"
              description: "NVD API key for Dependency-Check ('none' = no key)"
          - usernamePassword:
              scope: GLOBAL
              id: "github-gitops-token"
              username: "${GITHUB_USER}"
              password: "${GITHUB_PAT}"
              description: "GitHub PAT: clone, branch scan and GitOps record commits"

jobs:
  - script: |
      multibranchPipelineJob('{{ jenkins_job_name }}') {
        displayName('{{ jenkins_job_name }}')
        branchSources {
          github {
            id('{{ jenkins_job_name }}-github')
            repoOwner('{{ github_owner }}')
            repository('{{ github_repo }}')
            scanCredentialsId('github-gitops-token')
          }
        }
        factory {
          workflowBranchProjectFactory {
            scriptPath('Jenkinsfile')
          }
        }
        orphanedItemStrategy {
          discardOldItems {
            numToKeep(10)
          }
        }
        triggers {
          periodicFolderTrigger {
            interval('5m')
          }
        }
      }
