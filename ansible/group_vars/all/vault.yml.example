---
# cp vault.yml.example vault.yml && ansible-vault encrypt vault.yml     (vault.yml is git-ignored)
vault_sonar_admin_password: "a-strong-password"
vault_sonar_db_password: "another-strong-password"
vault_jenkins_admin_password: "a-third-strong-password"
vault_aws_account_id: "123456789012"
vault_nvd_api_key: "none"            # or your key from nvd.nist.gov
vault_github_user: "your-github-username"
vault_github_pat: "ghp_xxxxxxxx"     # scopes: repo (+ admin:repo_hook if manage_github_webhook)
